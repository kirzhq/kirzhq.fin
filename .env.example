# Generate a strong value, for example: openssl rand -base64 32
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=finance_tracker
POSTGRES_USER=finance

# Local: http://localhost
# Production: your-domain.example (Caddy enables HTTPS automatically)
SITE_ADDRESS=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# Telegram-бот. Никогда не добавляйте настоящий токен в Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Отдельный отзывной токен для команды iPhone. Например: openssl rand -hex 32
SHORTCUT_API_TOKEN=

# Временный пароль нужен только для первой регистрации passkey.
AUTH_USERNAME=finance
AUTH_SETUP_PASSWORD=replace-with-a-long-random-password
AUTH_RP_ID=fin.example.com
AUTH_ORIGIN=https://fin.example.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=kirzhq.ru
