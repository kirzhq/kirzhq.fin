{$SITE_ADDRESS:http://localhost} {
    encode zstd gzip

    @pwa_assets path /manifest.webmanifest /service-worker.js /apple-touch-icon.png /pwa-icon-192.png /pwa-icon-512.png /pwa-icon.svg /finance-favicon.svg
    handle @pwa_assets {
        reverse_proxy kirzhq-fin-frontend-1:80
    }

    handle /api/shortcut/* {
        reverse_proxy kirzhq-fin-backend-1:8080
    }

    handle /api/* {
        route {
            vars original_uri {uri}
            forward_auth kirzhq-home-backend:8080 {
                uri /api/auth/check
            }
            rewrite * {vars.original_uri}
            reverse_proxy kirzhq-fin-backend-1:8080
        }
    }

    # The beta build is merged into the main one; keep old links working.
    redir /beta* / permanent

    handle {
        route {
            vars original_uri {uri}
            forward_auth kirzhq-home-backend:8080 {
                uri /api/auth/check
            }
            rewrite * {vars.original_uri}
            reverse_proxy kirzhq-fin-frontend-1:80
        }
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

home.kirzhq.ru {
    encode zstd gzip

    handle /login* {
        reverse_proxy kirzhq-home-backend:8080
    }

    handle /logout {
        reverse_proxy kirzhq-home-backend:8080
    }

    handle /webauthn/* {
        reverse_proxy kirzhq-home-backend:8080
    }

    handle /default-ui.css {
        reverse_proxy kirzhq-home-backend:8080
    }

    handle /api/* {
        reverse_proxy kirzhq-home-backend:8080
    }

    handle {
        route {
            vars original_uri {uri}
            forward_auth kirzhq-home-backend:8080 {
                uri /api/auth/check
            }
            rewrite * {vars.original_uri}
            reverse_proxy kirzhq-home-frontend:80
        }
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}

sync.kirzhq.ru {
    encode zstd gzip

    handle /obsync-plugin-1.7.4.zip {
        root * /srv/obsync-downloads
        file_server
    }

    handle {
        reverse_proxy obsync-server:4444
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
    }
}
